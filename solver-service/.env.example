# ─── Server ───────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Starknet ─────────────────────────────
RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/qXU4ta4yLmxUhIoLb-cZ7KtsNn808Pjw
BNS_CONTRACT_ADDRESS=0xfad69cad592fc44fe3673717a643929eb5a62689eb2abeb7a1a0d3ae105371
NETWORK=starknet-sepolia

# ─── Security ─────────────────────────────
# Comma-separated list of allowed origins.
# Leave empty to allow all origins (development).
# Example: https://app.brother.domains,https://avnu.fi,https://braavos.app
ALLOWED_ORIGINS=

# ─── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # Max requests per IP per window
SLOW_DOWN_THRESHOLD=50        # Requests before slowdown kicks in
SLOW_DOWN_DELAY_MS=500        # Milliseconds added per extra request

# ─── Caching ──────────────────────────────
CACHE_TTL_SECS=60             # TTL for successful resolutions
NEGATIVE_CACHE_TTL_SECS=5    # TTL for not-found results
